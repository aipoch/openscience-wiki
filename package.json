{
  "name": "aipoch-open-science-docs",
  "version": "0.14.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run check:english && next build",
    "start": "next start",
    "lint": "eslint .",
    "types:check": "next typegen && tsc --noEmit",
